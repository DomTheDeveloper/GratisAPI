{
  "openapi": "3.1.0",
  "info": {
    "title": "GratisAPI",
    "version": "1.0.0",
    "summary": "A completely free, static, open-data API.",
    "description": "GratisAPI is served entirely from static JSON files on GitHub Pages. Every path below resolves to a real file you can `curl` or `fetch` directly — no authentication, no rate limits, no cost. Only HTTP GET is supported.",
    "license": {
      "name": "GPL-2.0-or-later",
      "url": "https://www.gnu.org/licenses/old-licenses/gpl-2.0.html"
    },
    "contact": {
      "name": "GratisAPI on GitHub",
      "url": "https://github.com/DomTheDeveloper/GratisAPI"
    }
  },
  "servers": [
    {
      "url": "https://domthedeveloper.github.io/GratisAPI",
      "description": "GitHub Pages (production)"
    }
  ],
  "tags": [
    {
      "name": "meta",
      "description": "Discovery and metadata endpoints."
    },
    {
      "name": "animals",
      "description": "Biological taxonomy of animals, from kingdom down to species."
    },
    {
      "name": "quotes",
      "description": "Memorable quotes from famous people throughout history."
    },
    {
      "name": "colors",
      "description": "Named web colors with hex, RGB and HSL values."
    },
    {
      "name": "countries",
      "description": "Countries of the world with capital, ISO codes, continent and currency."
    },
    {
      "name": "continents",
      "description": "The seven continents of Earth with area, population and country counts."
    },
    {
      "name": "planets",
      "description": "Planets and dwarf planets of the Solar System with key physical data."
    },
    {
      "name": "elements",
      "description": "The 118 elements of the periodic table with symbol, atomic number, mass and category."
    },
    {
      "name": "http-status",
      "description": "HTTP response status codes with their standard reason phrase and category."
    },
    {
      "name": "currencies",
      "description": "World currencies with ISO 4217 code, symbol and minor unit."
    },
    {
      "name": "languages",
      "description": "Human languages with ISO 639-1 code, native name and writing direction."
    },
    {
      "name": "zodiac",
      "description": "The twelve signs of the Western zodiac with dates, elements and symbols."
    },
    {
      "name": "calendar",
      "description": "Months of the year and days of the week with ordinal, length and abbreviation."
    }
  ],
