        "summary": "Get a single animals record by id",
        "operationId": "get_animals",
        "tags": [
          "animals"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The record identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested record."
